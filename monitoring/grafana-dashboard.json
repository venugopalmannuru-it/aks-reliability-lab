{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (route) (rate(http_requests_total{route!=\"metrics\"}[5m]))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "Request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum(rate(http_requests_total{route!=\"metrics\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{route!=\"metrics\"}[5m])), 0.001)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "Server error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (route) (rate(http_request_duration_seconds_total{route!=\"metrics\"}[5m])) / clamp_min(sum by (route) (rate(http_requests_total{route!=\"metrics\"}[5m])), 0.001)", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "Mean response time by route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(kube_deployment_status_replicas_available{deployment=~\".*reliability.*\"})", "legendFormat": "available pods", "refId": "A"}],
      "title": "Available replicas",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["portfolio", "kubernetes", "reliability"],
  "templating": {
    "list": [{"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "label": "Prometheus"}]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "AKS Reliability Lab",
  "uid": "aks-reliability-lab",
  "version": 1
}
